pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Java Bytecode & Logs de Crash da JVM
*.class
hs_err_pid*
replay_pid*

# Arquivo gerado pelo Spring Initializr
HELP.md

